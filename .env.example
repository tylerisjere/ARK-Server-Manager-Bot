# Kopiere in .env (NICHT ins Repo) oder setze als Replit Secrets
DISCORD_TOKEN=your_discord_token_here
ALERT_CHANNEL_ID=discord_channel_id_for_alerts
MOD_ROLE_IDS=roleid1,roleid2

FTP_HOST=ftp.nitrado.net
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASS=ftp_password
FTP_LOGS_PATH=ShooterGame/Saved/Logs
FTP_SECURE=false

RCON_ENABLED=true
RCON_HOST=server_ip_or_host
RCON_PORT=27020
RCON_PASS=rcon_password

POLL_INTERVAL_MINUTES=3
PREFIX=!
